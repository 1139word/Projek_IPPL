# Salin file ini menjadi .env lalu isi API key. File .env TIDAK boleh di-push ke GitHub.
GEMINI_API_KEY=isi_api_key_di_sini
# API key DeepSeek (platform.deepseek.com > API keys). RAHASIA, isi hanya di .env.
# Kosongkan bila belum punya: model DeepSeek V4.1 Flash akan gagal, model Gemini tetap jalan.
DEEPSEEK_API_KEY=

# Nama model di API (boleh dikosongkan: backend memakai nama bawaan di lib/models.js).
# Isi hanya bila Google/DeepSeek mengganti nama model. Biaya credit tidak diatur di sini.
#   Gemini 3.1 Flash-Lite (1 credit) -> gemini-3.1-flash-lite
#   DeepSeek V4.1 Flash   (1 credit) -> deepseek-flash
#   Gemini 3.5 Flash      (1 credit) -> gemini-3.5-flash
#   Gemini 3.1 Pro        (2 credit) -> gemini-3.1-pro-preview
GEMINI_MODEL_FLASH_LITE=
DEEPSEEK_MODEL=
GEMINI_MODEL_FLASH=
GEMINI_MODEL_PRO=

# Alamat layanan OCR Python dan port backend
OCR_URL=http://127.0.0.1:5001/ocr
PORT=3000

# Database MySQL (akun khusus backend, bukan root)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=image_translator
DB_PASSWORD=isi_password_akun_backend
DB_NAME=image_translator

# Credit awal untuk akun baru (diberikan sekali saat registrasi). Paket credit dan harganya
# tidak diatur di sini, tetapi di tabel credit_packages pada database.
CREDIT_AWAL=10

# Midtrans (pembayaran QRIS). Server Key RAHASIA: isi hanya di .env, jangan di file ini.
# Ambil dari dashboard.midtrans.com > mode Sandbox > Settings > Access Keys.
MIDTRANS_SERVER_KEY=
# 0 = Sandbox (uji coba, tanpa uang sungguhan), 1 = Production
MIDTRANS_PRODUCTION=0

# Login Google: Client ID dari Google Cloud (OAuth Client tipe Chrome Extension).
# Bukan rahasia (nilai yang sama juga ada di extension/manifest.json), jadi sudah diisi.
GOOGLE_CLIENT_ID=739555755065-8rn5fpn60gs59a819su9ubgt2aufoe40.apps.googleusercontent.com

# Isi 1 untuk menampilkan setiap balon (jenis, teks OCR, terjemahan) di terminal backend. Untuk diagnosis.
LOG_DETAIL=0
