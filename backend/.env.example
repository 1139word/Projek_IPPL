# Salin file ini menjadi .env lalu isi API key. File .env TIDAK boleh di-push ke GitHub.
GEMINI_API_KEY=isi_api_key_di_sini

# Model Gemini (bisa diganti bila Google mengganti nama model)
GEMINI_MODEL_STD=gemini-3.5-flash-lite
GEMINI_MODEL_ADV=gemini-3.8-flash

# Alamat layanan OCR Python dan port backend
OCR_URL=http://127.0.0.1:5001/ocr
PORT=3000

# Database MySQL (akun khusus backend, bukan root)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=image_translator
DB_PASSWORD=isi_password_akun_backend
DB_NAME=image_translator

# Kuota credit per minggu
CREDIT_QUOTA_FREE=10
CREDIT_QUOTA_PREMIUM=100

# Login Google: Client ID dari Google Cloud (OAuth Client tipe Chrome Extension)
GOOGLE_CLIENT_ID=isi_client_id_di_sini
